# ---------------------------------------------------------------------------
# TALLY environment
#
# Local development:
#   copy this file to .env
#   npm run dev
#
# Production (Vercel):
#   add the same keys in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. In production this must point at Neon.
# Neon's pooled connection string is recommended for serverless functions.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Required in production. At least 32 random characters. Used to sign the
# HTTP-only session cookie. Changing it signs every browser out.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-me-with-at-least-32-random-characters

# Set automatically by Vercel; override locally when simulating production.
# NODE_ENV=development

# Local API server (the Vite dev server proxies /api to it).
PORT=3000
HOST=0.0.0.0

# Set true on HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Keep the session for this many days.
# SESSION_DAYS=30

# PostgreSQL pool tuning.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=10000

# Local-only embedded PostgreSQL fallback (PGlite). In production DATABASE_URL
# is required and PGlite is never used.
# TALLY_PGLITE_DIR=./tally-data/pglite

# Local built client path when using `npm start`.
# TALLY_CLIENT_DIST=./dist/client

# Logging.
# LOG_LEVEL=info
