# ---------------------------------------------------------------------------
# TALLY .gitignore
#
# Commit source, migrations, and tests.
# Never commit the local ledger, secrets, or build output.
# ---------------------------------------------------------------------------

# Dependencies and build output
node_modules/
dist/
coverage/
.nyc_output/
*.tsbuildinfo
.vite/
.turbo/
.eslintcache

# Runtime state: embedded PGlite and logs. The legacy database patterns remain
# so an old local data directory is never committed.
tally-data/
tally-data-*/
.pgtest/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
*.local

# Test and tool artifacts
test-results/
playwright-report/
junit.xml
*.lcov

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
